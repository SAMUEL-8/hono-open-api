NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
# Wrap values containing special characters (#, $, spaces, quotes) in double quotes,
# e.g. DATABASE_PASSWORD="p@ss#w$rd". Unquoted, "#" starts a comment and truncates the value.
DATABASE_PASSWORD=postgres
DATABASE_NAME=hono_open_api